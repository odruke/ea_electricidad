{
	admin off
	auto_https off

	# TLS ends at the shared VPS reverse proxy; trust its forwarded client address in logs.
	servers {
		trusted_proxies static private_ranges
	}
}

# Site policy lives here, not in the shared proxy: the proxy serves many projects and only
# terminates TLS and forwards the request (see README, "Shared reverse proxy").
(security_headers) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'"
		-Server
	}
}

# Static site. Published to no host port: reachable only on the `proxy` network (alias
# `ea-electricidad-web`) and the project's private `app` network.
:8080 {
	root * /srv
	encode zstd gzip

	import security_headers

	@health path /healthz
	respond @health "ok" 200

	@root path /
	redir @root /es/ 308

	@missingSlash {
		not path */
		not path *.*
		not path /healthz
		not path /api
		not path /api/*
	}
	redir @missingSlash {path}/ 308

	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Future backend (004): add a `backend` service on the `app` network, then route it here
	# before the file server:
	#
	# handle /api/* {
	# 	reverse_proxy backend:3000
	# }

	try_files {path} {path}/ {path}/index.html
	file_server

	log {
		output stdout
		format json
	}

	# Error responses keep their status and must re-import the headers.
	handle_errors {
		import security_headers

		@es path /es/*
		handle @es {
			rewrite * /es/404/index.html
			file_server
		}

		@en path /en/*
		handle @en {
			rewrite * /en/404/index.html
			file_server
		}

		@fr path /fr/*
		handle @fr {
			rewrite * /fr/404/index.html
			file_server
		}

		handle {
			rewrite * /es/404/index.html
			file_server
		}
	}
}
