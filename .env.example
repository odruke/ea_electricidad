# Local defaults. Copy to `.env` with `cp .env.example .env` and adjust as needed.
# The same file works on any Docker-capable host; only the values change.

# Absolute base URL used for canonical links, hreflang, and the sitemap (no trailing slash).
SITE_URL=http://localhost

# staging | production. Staging emits noindex and disallows crawlers.
SITE_ENV=staging

# Host and TLS address used by the public edge. `:80` serves plain HTTP locally.
SITE_ADDRESS=:80

# Production-style example (requires DNS pointed at the host and free 80/443):
# SITE_URL=https://example.com
# SITE_ADDRESS=https://example.com
# SITE_ENV=production
