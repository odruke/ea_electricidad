# Local defaults. Copy to `.env` with `cp .env.example .env` and adjust as needed.
# The VPS uses the same file with the staging values shown below.

# Absolute base URL used for canonical links, hreflang, and the sitemap (no trailing slash).
SITE_URL=http://localhost

# staging | production. Staging emits noindex and disallows crawlers.
SITE_ENV=staging

# Host and TLS address used by Caddy. `:80` serves plain HTTP locally.
SITE_ADDRESS=:80

# Staging VPS example:
# SITE_URL=https://203.0.113.10.sslip.io
# SITE_ADDRESS=https://203.0.113.10.sslip.io
