# Local defaults. Copy to `.env` with `cp .env.example .env` and adjust as needed.
# The same file works on the VPS; only the values change.

# Absolute base URL used for canonical links, hreflang, and the sitemap (no trailing slash).
SITE_URL=http://localhost

# staging | production. Staging emits noindex and disallows crawlers.
SITE_ENV=staging

# The domain, TLS and public ports are configured in the shared reverse proxy project on
# the VPS, not here. This project only needs SITE_URL to match that domain.
#
# Production-style example:
# SITE_URL=https://example.com
# SITE_ENV=production
