---
import Hero from '@/components/home/Hero.astro';
import WorkCategories from '@/components/home/WorkCategories.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ButtonLink from '@/components/ui/ButtonLink.astro';
import Container from '@/components/ui/Container.astro';
import { site, whatsappUrl } from '@/config/site';
import { getDictionary } from '@/i18n';
import { assertLocale, localeStaticPaths } from '@/lib/routes';

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = assertLocale(Astro.params.locale);
const t = getDictionary(locale);
const whatsappHref = whatsappUrl(t.whatsapp.message);
---

<BaseLayout
  locale={locale}
  title={t.meta.home.title}
  description={t.meta.home.description}
  path="/"
>
  <Hero locale={locale} />
  <WorkCategories locale={locale} />

  <section class="on-dark border-t-4 border-accent bg-brand text-white">
    <Container class="py-10 sm:py-12">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-2xl" data-reveal="up">
          <h2 class="text-2xl font-semibold sm:text-3xl">{t.home.contactHeading}</h2>
          <p class="mt-2 leading-relaxed text-white/85">{t.home.contactLead}</p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row">
          <ButtonLink href={site.phone.href} variant="accent" icon="phone">
            {t.cta.call}
          </ButtonLink>
          <ButtonLink href={whatsappHref} variant="whatsapp" icon="whatsapp">
            {t.cta.whatsapp}
          </ButtonLink>
        </div>
      </div>
    </Container>
  </section>

  <script>
    import '@/scripts/home-reveal';
    import '@/scripts/home-slideshow';
  </script>
</BaseLayout>
