---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ButtonLink from '@/components/ui/ButtonLink.astro';
import Container from '@/components/ui/Container.astro';
import PlaceholderMedia from '@/components/ui/PlaceholderMedia.astro';
import Section from '@/components/ui/Section.astro';
import { site, whatsappUrl } from '@/config/site';
import { getDictionary } from '@/i18n';
import { assertLocale, localizedPath, localeStaticPaths } from '@/lib/routes';
import { getServiceItems } from '@/lib/services';

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = assertLocale(Astro.params.locale);
const t = getDictionary(locale);
const services = getServiceItems(t);
const contactHref = localizedPath(locale, '/contact/');
const servicesHref = localizedPath(locale, '/services/');
---

<BaseLayout
  locale={locale}
  title={t.meta.home.title}
  description={t.meta.home.description}
  path="/"
>
  <section class="on-dark bg-brand text-white">
    <Container class="grid gap-10 py-16 sm:py-20 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:py-24">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">{t.home.eyebrow}</p>
        <h1 class="mt-4 text-4xl font-bold leading-tight sm:text-5xl">{t.home.title}</h1>
        <p class="mt-5 max-w-2xl text-lg text-white/85">{t.home.lead}</p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <ButtonLink href={contactHref} variant="accent">
            {t.cta.quote}
          </ButtonLink>
          <ButtonLink href={servicesHref} variant="ghost">
            {t.cta.viewServices}
          </ButtonLink>
        </div>

        <ul class="mt-10 grid gap-3 text-sm sm:grid-cols-3">
          <li class="rounded border border-white/20 px-3 py-2">{t.home.facts.experience}</li>
          <li class="rounded border border-white/20 px-3 py-2">{t.home.facts.authorization}</li>
          <li class="rounded border border-white/20 px-3 py-2">{t.home.facts.insurance}</li>
        </ul>
      </div>

      <div>
        <PlaceholderMedia locale={locale} />
        <p class="mt-3 text-xs text-white/70">{t.home.placeholderNote}</p>
      </div>
    </Container>
  </section>

  <Section>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold sm:text-3xl">{t.home.servicesHeading}</h2>
        <p class="mt-2 max-w-xl text-ink-muted">{t.home.servicesLead}</p>
      </div>
      <ButtonLink href={servicesHref} variant="ghost">
        {t.cta.viewServices}
      </ButtonLink>
    </div>

    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <li class="rounded-card border border-line bg-white p-5">
          <h3 class="text-lg font-semibold">{service.title}</h3>
          <p class="mt-2 text-sm text-ink-muted">{service.description}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section tone="brand">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-2xl font-bold sm:text-3xl">{t.home.contactHeading}</h2>
        <p class="mt-2 max-w-2xl text-white/85">{t.home.contactLead}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <ButtonLink href={site.phone.href} variant="accent">
          {t.cta.call}
        </ButtonLink>
        <ButtonLink href={whatsappUrl(t.whatsapp.message)} variant="ghost">
          {t.cta.whatsapp}
        </ButtonLink>
      </div>
    </div>
  </Section>
</BaseLayout>
