---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ButtonLink from '@/components/ui/ButtonLink.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import { site, whatsappUrl } from '@/config/site';
import { getDictionary } from '@/i18n';
import { assertLocale, localeStaticPaths } from '@/lib/routes';
import { getServiceItems } from '@/lib/services';

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = assertLocale(Astro.params.locale);
const t = getDictionary(locale);
const services = getServiceItems(t);
---

<BaseLayout
  locale={locale}
  title={t.meta.services.title}
  description={t.meta.services.description}
  path="/services/"
>
  <section class="on-dark bg-brand text-white">
    <Container class="py-14 sm:py-20">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">
        {t.services.eyebrow}
      </p>
      <h1 class="mt-4 max-w-3xl text-3xl font-bold leading-tight sm:text-4xl lg:text-5xl">
        {t.services.title}
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-white/85">{t.services.lead}</p>
    </Container>
  </section>

  <Section>
    <ul class="grid gap-6 sm:grid-cols-2">
      {services.map((service, index) => (
        <li class="rounded-card border border-line bg-white p-6">
          <p class="font-display text-sm font-semibold text-brand">
            {String(index + 1).padStart(2, '0')}
          </p>
          <h2 class="mt-2 text-xl font-semibold">{service.title}</h2>
          <p class="mt-2 text-ink-muted">{service.description}</p>
        </li>
      ))}
    </ul>

    <p class="mt-8 max-w-3xl rounded border-l-4 border-accent bg-surface-muted p-4 text-sm text-ink-muted">
      {t.services.note}
    </p>
  </Section>

  <Section tone="muted">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-2xl font-bold sm:text-3xl">{t.services.ctaHeading}</h2>
        <p class="mt-2 max-w-xl text-ink-muted">{t.services.ctaLead}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <ButtonLink href={site.phone.href} variant="primary">
          {t.cta.call}
        </ButtonLink>
        <ButtonLink href={whatsappUrl(t.whatsapp.message)} variant="ghost">
          {t.cta.whatsapp}
        </ButtonLink>
      </div>
    </div>
  </Section>
</BaseLayout>
