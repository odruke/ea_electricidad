---
interface Props {
  href: string;
  variant?: 'primary' | 'accent' | 'ghost';
  class?: string;
}

const { href, variant = 'primary', class: className } = Astro.props;

const variants = {
  primary: 'bg-brand text-white hover:bg-brand-strong',
  accent: 'bg-accent text-brand hover:bg-accent-strong',
  ghost: 'border border-line bg-white text-brand hover:border-brand',
} as const;
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-md px-5 py-3 text-base font-semibold no-underline transition-colors',
    variants[variant],
    className,
  ]}
>
  <slot />
</a>
