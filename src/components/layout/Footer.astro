---
import { site, whatsappUrl } from '@/config/site';
import { getDictionary } from '@/i18n';
import { localizedPath, type Locale } from '@/lib/routes';
import Container from '@/components/ui/Container.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const year = new Date().getFullYear();

const linkClass =
  'text-white underline decoration-white/40 underline-offset-2 hover:text-accent hover:decoration-accent';
const headingClass = 'text-sm font-semibold text-accent';
---

<footer class="on-dark border-t border-white/15 bg-brand text-white">
  <Container class="py-6 sm:py-8">
    <div class="grid gap-6 sm:grid-cols-3" data-testid="footer-columns">
      <div>
        <h2 class={headingClass}>{t.footer.contactHeading}</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a href={site.phone.href} class={linkClass}>
              {site.phone.display}
            </a>
          </li>
          <li>
            <a href={whatsappUrl(t.whatsapp.message)} class={linkClass}>
              {t.cta.whatsapp}
            </a>
          </li>
          <li>
            <a href={site.email.href} class:list={[linkClass, 'break-words']}>
              {site.email.display}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h2 class={headingClass}>{t.footer.hoursHeading}</h2>
        <p class="mt-3 text-sm">{t.contact.hoursValue}</p>
        <p class="mt-1 text-xs text-white/70">{t.contact.hoursNote}</p>
      </div>

      <div>
        <h2 class={headingClass}>{t.footer.areaHeading}</h2>
        <p class="mt-3 text-sm">{site.serviceArea.join(', ')}</p>
        <p class="mt-1 text-xs text-white/70">{t.contact.areaNote}</p>
      </div>
    </div>

    <div class="mt-6 flex flex-col gap-3 border-t border-white/15 pt-4 text-xs text-white/70 sm:flex-row sm:items-center sm:justify-between">
      <p>
        © {year} {site.name}. {t.footer.rights}
      </p>
      <a href={localizedPath(locale, '/legal/')} class={linkClass}>
        {t.footer.legalLink}
      </a>
    </div>
  </Container>
</footer>
