---
import { site, whatsappUrl } from '@/config/site';
import { getDictionary } from '@/i18n';
import { localizedPath, type Locale } from '@/lib/routes';
import Container from '@/components/ui/Container.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const year = new Date().getFullYear();

const linkClass =
  'text-white underline decoration-white/40 underline-offset-2 hover:text-accent hover:decoration-accent';
---

<footer class="on-dark bg-brand text-white">
  <Container class="py-12 sm:py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="font-display text-lg font-semibold leading-tight">{site.name}</p>
        <p class="mt-2 text-sm text-white/80">{t.footer.tagline}</p>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-accent">
          {t.footer.contactHeading}
        </h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a href={site.phone.href} class={linkClass}>
              {site.phone.display}
            </a>
          </li>
          <li>
            <a href={whatsappUrl(t.whatsapp.message)} class={linkClass}>
              {t.cta.whatsapp}
            </a>
          </li>
          <li>
            <a href={site.email.href} class={linkClass}>
              {site.email.display}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-accent">
          {t.footer.hoursHeading}
        </h2>
        <p class="mt-3 text-sm">{t.contact.hoursValue}</p>
        <p class="mt-1 text-xs text-white/70">{t.contact.hoursNote}</p>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-accent">
          {t.footer.areaHeading}
        </h2>
        <p class="mt-3 text-sm">{site.serviceArea.join(', ')}</p>
        <p class="mt-1 text-xs text-white/70">{t.contact.areaNote}</p>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-3 border-t border-white/20 pt-6 text-xs text-white/70 sm:flex-row sm:items-center sm:justify-between">
      <p>
        © {year} {site.name}. {t.footer.rights}
      </p>
      <a href={localizedPath(locale, '/legal/')} class={linkClass}>
        {t.footer.legalLink}
      </a>
    </div>
  </Container>
</footer>
