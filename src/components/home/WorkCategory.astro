---
import Container from '@/components/ui/Container.astro';
import { getDictionary } from '@/i18n';
import type { WorkCategory } from '@/lib/home-work';
import type { Locale } from '@/lib/routes';

import WorkSlideshow from './WorkSlideshow.astro';

interface Props {
  locale: Locale;
  category: WorkCategory;
}

const { locale, category } = Astro.props;
const t = getDictionary(locale);
const copy = t.home.work.categories[category.key];

const stageFirst = category.stageSide === 'left';
const revealDirection = stageFirst ? 'left' : 'right';
const stageOrder = stageFirst ? 'md:order-1' : 'md:order-2';
const copyOrder = stageFirst ? 'md:order-2' : 'md:order-1';
const toneClass = category.tone === 'muted' ? 'bg-surface-muted' : 'bg-white';
---

<section
  class:list={['py-14 sm:py-20', toneClass]}
  aria-labelledby={`work-${category.key}`}
  data-testid="work-category"
  data-category={category.key}
>
  <Container>
    <div class="grid gap-8 md:grid-cols-12 md:items-center md:gap-8 lg:gap-12">
      <div class:list={['md:col-span-7 lg:col-span-8', stageOrder]} data-reveal={revealDirection}>
        <WorkSlideshow
          locale={locale}
          categoryKey={category.key}
          title={copy.title}
          images={category.images}
        />
      </div>

      <div class:list={['md:col-span-5 lg:col-span-4', copyOrder]}>
        <div data-reveal="up">
          <h2
            id={`work-${category.key}`}
            class="flex items-start gap-3 text-[clamp(1.9rem,3.2vw,2.75rem)] font-semibold leading-tight tracking-[-0.02em]"
          >
            <span class="mt-2.5 h-2.5 w-2.5 shrink-0 bg-accent" aria-hidden="true"></span>
            <span>{copy.title}</span>
          </h2>
          <p class="mt-3 max-w-[42ch] leading-relaxed text-ink-muted">{copy.lead}</p>
        </div>

        <ul
          class="reveal-stagger mt-6 border-t border-line"
          data-testid={`bullets-${category.key}`}
        >
          {copy.bullets.map((bullet) => (
            <li class="flex items-start gap-3 border-b border-line py-3" data-reveal="up">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-accent" aria-hidden="true" />
              <span>{bullet}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Container>
</section>
