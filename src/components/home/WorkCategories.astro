---
import { workCategories } from '@/lib/home-work';
import type { Locale } from '@/lib/routes';

import WorkCategory from './WorkCategory.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

{workCategories.map((category) => (
  <WorkCategory locale={locale} category={category} />
))}
