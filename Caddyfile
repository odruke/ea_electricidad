{
	admin off
}

(security_headers) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'"
		-Server
	}
}

# Liveness endpoint for the edge container. Not published to the host.
http://:8081 {
	respond /healthz "ok" 200
	respond 404
}

{$SITE_ADDRESS} {
	encode zstd gzip

	import security_headers

	@health path /healthz
	respond @health "ok" 200

	@root path /
	redir @root /es/ 308

	@missingSlash {
		not path */
		not path *.*
		not path /healthz
		not path /api
		not path /api/*
	}
	redir @missingSlash {path}/ 308

	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Future backend (004): add a `backend` service to the `app` network, then
	# replace the single proxy below with these ordered handlers.
	#
	# handle /api/* {
	# 	reverse_proxy backend:3000
	# }
	# handle {
	# 	reverse_proxy web:8080
	# }
	reverse_proxy web:8080

	log {
		output stdout
		format json
	}

	handle_errors {
		import security_headers
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
