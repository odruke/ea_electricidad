{
	admin off
}

(security_headers) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'"
		-Server
	}
}

# Liveness endpoint for container orchestration. Not published publicly.
http://:8080 {
	respond /healthz "ok" 200
	respond 404
}

{$SITE_ADDRESS} {
	encode zstd gzip

	import security_headers

	root * /srv

	@health path /healthz
	respond @health "ok" 200

	@root path /
	redir @root /es/ 308

	@missingSlash {
		not path */
		not path *.*
		not path /healthz
	}
	redir @missingSlash {path}/ 308

	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	try_files {path} {path}/ {path}/index.html
	file_server

	log {
		output stdout
		format json
	}

	handle_errors {
		@es path /es/*
		handle @es {
			import security_headers
			rewrite * /es/404/index.html
			file_server
		}

		@en path /en/*
		handle @en {
			import security_headers
			rewrite * /en/404/index.html
			file_server
		}

		@fr path /fr/*
		handle @fr {
			import security_headers
			rewrite * /fr/404/index.html
			file_server
		}

		handle {
			import security_headers
			rewrite * /es/404/index.html
			file_server
		}
	}
}
